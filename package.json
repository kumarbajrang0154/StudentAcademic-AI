{
  "name": "student-academic-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "npm run db:generate -w @student-academic-ai/database",
    "db:migrate": "npm run db:migrate -w @student-academic-ai/database",
    "db:seed": "npm run db:seed -w @student-academic-ai/database",
    "db:verify": "npm run db:verify -w @student-academic-ai/database",
    "db:recompute": "npm run db:recompute -w @student-academic-ai/database",
    "smoke:student": "tsx scripts/smoke-student.ts",
    "smoke:faculty": "tsx scripts/smoke-faculty.ts",
    "smoke:mentor": "tsx scripts/smoke-mentor.ts",
    "smoke:admin": "tsx scripts/smoke-admin.ts",
    "smoke:reports": "tsx scripts/smoke-reports.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prettier": "^3.5.2",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
