{
  "name": "@student-academic-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@student-academic-ai/core": "workspace:*",
    "@student-academic-ai/database": "workspace:*",
    "@student-academic-ai/types": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@student-academic-ai/config": "workspace:*",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
